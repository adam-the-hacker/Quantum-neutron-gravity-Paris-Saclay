#                     PARTIE I : PROBLEME STATIONNAIRE
#%% 2. Solveur stationnaire (identique pour tous les potentiels)

def etats_propres(a, b, M, Vdef, nb):
    """Renvoie x (M+1 points), E (nb premières énergies), phi (M+1, nb)."""
    dx = (b - a) / M
    c = 1 / dx**2
    x = np.linspace(a, b, M + 1)
    V = Vdef(x)

    # matrice H sur les M-1 points intérieurs (bords : phi = 0)
    n = M - 1
    H = np.zeros([n, n])
    for k in range(n):
        H[k, k] = c + V[k + 1]
        if k > 0:
            H[k, k - 1] = -c / 2
        if k < n - 1:
            H[k, k + 1] = -c / 2

    # H est symétrique réelle : eigh renvoie déjà les valeurs triées
    E, phi_int = eigh(H)
    E = E[:nb]

    phi = np.zeros([M + 1, nb])
    phi[1:M, :] = phi_int[:, :nb]
    for k in range(nb):
        phi[:, k] /= np.sqrt(np.sum(phi[:, k]**2) * dx)       # normalisation
        i0 = np.argmax(np.abs(phi[:, k]) > 1e-3 * np.abs(phi[:, k]).max())
        if phi[i0, k] < 0:                                    # signe
            phi[:, k] *= -1
    return x, E, phi

#%% 3. Les potentiels
# --- 3.1 puits infini  (domaine [0,1])
def V_puits_infini(x):
    return np.zeros_like(x)

# --- 3.2 oscillateur harmonique  V = x²/2     (E_n = n + 1/2)
def V_oscillateur(x):
    return 0.5 * x**2

# --- 3.3 puits fini : V = 0 pour |x|<1, V0 ailleurs
V0_puits, demi_largeur = 10.0, 1.0
def V_puits_fini(x):
    V = np.where(np.abs(x) < demi_largeur, 0.0, V0_puits)
    # sur les points qui tombent exactement sur la marche : valeur moyenne
    # (meilleure précision pour un potentiel discontinu)
    V[np.isclose(np.abs(x), demi_largeur)] = V0_puits / 2
    return V

# --- 3.4 double puits  V = (x²-4)²/8   (deux minima en x = ±2, barrière = 2)
def V_double_puits(x):
    return (x**2 - 4)**2 / 8

# --- 3.5 puits de Pöschl-Teller  V = -l(l+1)/(2 cosh²x),  l=3
#         E_n = -(l-n)²/2  pour n = 0,1,2
lam = 3
def V_poschl_teller(x):
    return -lam * (lam + 1) / (2 * np.cosh(x)**2)

# --- 3.6 potentiel de Morse  V = D (1 - exp(-alpha x))²   (vibration moléculaire)
D_morse, alpha = 8.0, 1.0
def V_morse(x):
    return D_morse * (1 - np.exp(-alpha * x))**2

# --- 3.7 neutron dans le champ de gravité  V = z  (mur en z=0)
def V_gravite(x):
    return x.copy()

#%% 4. Solutions exactes (pour vérifier ; None si on ne les connaît pas)
def E_exact_puits_fini(nb):
    # k = sqrt(2E), kappa = sqrt(2(V0-E)), demi-largeur l
    #   pair   : kappa = k tan(k l)      impair : kappa = -k cot(k l)
    l = demi_largeur
    def f_pair(E):
        k, ka = np.sqrt(2 * E), np.sqrt(2 * (V0_puits - E))
        return ka - k * np.tan(k * l)
    def f_impair(E):
        k, ka = np.sqrt(2 * E), np.sqrt(2 * (V0_puits - E))
        return ka + k / np.tan(k * l)
    Eg = np.linspace(1e-6, V0_puits - 1e-6, 20000)
    racines = []
    for f in (f_pair, f_impair):
        v = f(Eg)
        for i in range(len(Eg) - 1):
            if v[i] * v[i + 1] < 0 and abs(v[i]) < 50 and abs(v[i + 1]) < 50:
                racines.append(brentq(f, Eg[i], Eg[i + 1]))
    return np.sort(racines)[:nb]

