#%% 8. Solveurs instationnaires : EXPLICITE, IMPLICITE et SEMI-IMPLICITE
########################################################################

def evolution_explicite(a, b, M, N, T, Vdef, psi0def, V_instationnaire=False):
    """RK4. Vdef(x) si stationnaire, Vdef(x,t) si V_instationnaire=True.
    Renvoie x (M+1), t (N+1), psi (M+1, N+1)."""
    dx = (b - a) / M
    dt = T / N
    x = np.linspace(a, b, M + 1)
    t = np.linspace(0, T, N + 1)
    V = None if V_instationnaire else Vdef(x)

    # condition de stabilité de RK4
    V_max = np.max(np.abs(Vdef(x, 0.0) if V_instationnaire else V))
    if dt * (2 / dx**2 + V_max) > 2.8:
        print(f"ATTENTION : dt*(2/dx²+Vmax) = {dt*(2/dx**2+V_max):.2f} > 2.8 : "
              f"schéma explicite instable, augmenter N")

    def F(u, tt):                      # F = -i H u  (points intérieurs seulement)
        Vt = Vdef(x, tt) if V_instationnaire else V
        out = np.zeros_like(u)
        out[1:M] = -1j * (-0.5 * (u[0:M - 1] - 2 * u[1:M] + u[2:M + 1]) / dx**2
                          + Vt[1:M] * u[1:M])
        return out

    psi = np.asarray(psi0def(x), dtype=complex).copy()
    psi[0] = psi[M] = 0
    psi_num = np.zeros([M + 1, N + 1], dtype=complex)
    psi_num[:, 0] = psi

    for n in range(N):
        tn = t[n]
        k1 = F(psi, tn)
        k2 = F(psi + 0.5 * dt * k1, tn + 0.5 * dt)
        k3 = F(psi + 0.5 * dt * k2, tn + 0.5 * dt)
        k4 = F(psi + dt * k3, tn + dt)
        psi = psi + dt / 6 * (k1 + 2 * k2 + 2 * k3 + k4)
        psi_num[:, n + 1] = psi
        if np.max(np.abs(psi)) > 1e6:
            print(f"Instabilité numérique : boum au pas {n}")
            break
    return x, t, psi_num


def evolution_implicite(a, b, M, N, T, Vdef, psi0def):
    """Crank-Nicolson, V(x) stationnaire. Même sortie que evolution_explicite."""
    dx = (b - a) / M
    dt = T / N
    c = 1 / dx**2
    x = np.linspace(a, b, M + 1)
    t = np.linspace(0, T, N + 1)
    V = Vdef(x)

    # A psi^{n+1} = B psi^n   avec  A = I + i dt/2 H ,  B = I - i dt/2 H
    # ligne j de H : [-c/2, c + V_j, -c/2]
    A = np.zeros([M + 1, M + 1], dtype=complex)
    B = np.zeros([M + 1, M + 1], dtype=complex)
    A[0, 0] = 1; A[M, M] = 1                 # bords : psi = 0
    for j in range(1, M):
        H_ligne = np.array([-c / 2, c + V[j], -c / 2])
        A[j, [j - 1, j, j + 1]] = (1j * dt / 2) * H_ligne
        B[j, [j - 1, j, j + 1]] = -(1j * dt / 2) * H_ligne
        A[j, j] += 1
        B[j, j] += 1
    U = np.linalg.solve(A, B)                # matrice d'évolution, calculée une fois

    psi = np.asarray(psi0def(x), dtype=complex).copy()
    psi[0] = psi[M] = 0
    psi_num = np.zeros([M + 1, N + 1], dtype=complex)
    psi_num[:, 0] = psi
    for n in range(N):
        psi = U @ psi
        psi_num[:, n + 1] = psi
    return x, t, psi_num

def evolution_semi_implicite(a, b, M, N, T, Vdef, psi0def):
    dx = (b - a) / M
    dt = T / N
    r = 1j * dt / (4 * dx**2)
    x = np.linspace(a, b, M + 1)
    t = np.linspace(0, T, N + 1)

    #matrices Og et Od (COMPLEXES), construites comme dans DF3
    Og = np.zeros([M + 1, M + 1], dtype=complex)
    Od = np.zeros([M + 1, M + 1], dtype=complex)
    Og[0, 0] = 1                     # bords : psi = 0
    Og[M, M] = 1
    for j in range(1, M):            # j de 1 à M-1
        Og[j, [j - 1, j, j + 1]] = [-r, 1 + 2 * r, -r]
        Od[j, [j - 1, j, j + 1]] = [r, 1 - 2 * r, r]

    #initialisation
    psi = psi0def(x).astype(complex)
    psi_num = np.zeros([M + 1, N + 1], dtype=complex)
    psi_num[:, 0] = psi

    #boucle d'avancement temporel
    for n in range(N):               # pour n allant de 0 à N-1

        #terme explicite (le potentiel) à l'instant t_n
        NL = -1j * Vdef(x) * psi
        NL[0] = NL[M] = 0

        #mise à jour : on résout le système linéaire  Og psi = Od psi + dt NL
        psi = np.linalg.solve(Og, np.dot(Od, psi) + dt * NL)

        #enregistrer
        psi_num[:, n + 1] = psi

        #test d'instabilité numérique
        if np.max(np.abs(psi)) > 1e6:
            print('Instabilité numérique: boum au pas ' + str(n))
            break
    return x, t, psi_num

