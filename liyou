# solution exacte : psi = somme_n c_n phi_n exp(-i E_n t),
#   phi_n = sqrt(2) sin(n pi x),  E_n = (n pi)²/2,
#   c_n = <phi_n|psi0> = sqrt(60) * 4/(n pi)³  pour n impair, 0 pour n pair
def psi_exacte(x, t):
    psi = np.zeros([len(x), len(t)], dtype=complex)
    for n in range(1, 200, 2):
        cn = np.sqrt(60) * 4 / (n * np.pi)**3
        psi += cn * np.sqrt(2) * np.outer(np.sin(n * np.pi * x), np.exp(-1j * (n * np.pi)**2 / 2 * t))
    return psi

