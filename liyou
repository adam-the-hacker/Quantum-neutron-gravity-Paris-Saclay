#%% 13. Question 2 : le paquet d'onde initial
############################################
# Gaussienne  psi0 = C exp(-(z-z0)²/(2 d²))
# Normalisation : <psi0|psi0> = C² ∫ exp(-(z-z0)²/d²) dz = C² d sqrt(pi) = 1
#   => C = pi^(-1/4) d^(-1/2)          (domaine ]-inf, +inf[, paquet loin des bords)
z0 = 10.0                   # hauteur initiale (0 << z0 << D)
d = 1.0                     # largeur (d <~ 1 pour localiser, pas trop petit : résolution)
D = 40.0                    # hauteur du domaine (plusieurs dizaines)
C = np.pi**(-0.25) / np.sqrt(d)
 
def psi0_neutron(z):
    return C * np.exp(-(z - z0)**2 / (2 * d**2))
 
