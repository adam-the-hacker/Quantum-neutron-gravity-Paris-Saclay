#  Partie I:équation schrodinger stationnaire
a, b = 0.0, 1.0

# résolution (nombre de pas d'espace)
M = 200

# potentiel V(x) : ici puits infini (V = 0 dans [a,b])
def Vdef(x):
    return np.zeros_like(x)

# nombre d'états propres à afficher
nb = 4

dx = (b - a) / M
c = 1 / dx**2
x = np.linspace(a, b, M + 1)        # M+1 points, bords inclus
V = Vdef(x)

#%% 3. La matrice H
n = M - 1                          
H = np.zeros([n, n])

for k in range(n):                   # k = j-1, indice dans la matrice
    H[k, k] = c + V[k + 1]
    if k > 0:
        H[k, k - 1] = -c / 2
    if k < n - 1:
        H[k, k + 1] = -c / 2

#%% 4. Valeurs et vecteurs propres
# eig résout H phi = E phi
E, phi_int = eig(H)
E = np.real(E)

# on trie par énergie croissante : E_0 <= E_1 <= E_2 ...
ordre = np.argsort(E)
E = E[ordre]
phi_int = np.real(phi_int[:, ordre])

# on remet les points de bord (valeur 0) pour avoir des vecteurs de taille M+1
phi = np.zeros([M + 1, n])
phi[1:M, :] = phi_int

# normalisation :  <phi_n|phi_n> = somme phi_j² dx = 1
for k in range(n):
    phi[:, k] = phi[:, k] / np.sqrt(np.sum(phi[:, k]**2) * dx)
    # convention de signe : première valeur non négligeable positive
    i0 = np.argmax(np.abs(phi[:, k]) > 1e-8 * np.abs(phi[:, k]).max())
    if phi[i0, k] < 0:
        phi[:, k] = -phi[:, k]

#%% 5. Vérification : puits infini  (L=1)
# solution exacte : E_n = (n+1)² pi² / 2 ,  phi_n = sqrt(2) sin((n+1) pi x)
E_ex = (np.arange(1, nb + 1) * np.pi)**2 / 2
