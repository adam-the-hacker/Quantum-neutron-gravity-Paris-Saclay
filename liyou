    print(f"{k}   {E[k]:11.5f}   {E_ex[k]:11.5f}   {abs(E[k]-E_ex[k])/E_ex[k]:.2e}")

# orthonormalité : <phi_m|phi_n> = delta_mn
G = phi[:, :nb].T @ phi[:, :nb] * dx
